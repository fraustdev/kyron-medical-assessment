# Copy to .env (gitignored) and fill in. Any OpenAI-compatible endpoint works.
# Keys are sent only in the Authorization header: never written to traces, the LLM cache, or run metadata.

# The agent under test
AGENT_PROVIDER=
AGENT_BASE_URL=
AGENT_MODEL=
AGENT_API_KEY=

# The simulated caller (M4)
CALLER_PROVIDER=
CALLER_BASE_URL=
CALLER_MODEL=
CALLER_API_KEY=

# The evaluator's LLM judge (claim detection, judged checks). Falls back to CALLER_API_KEY.
JUDGE_PROVIDER=
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
